<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Per-TFM package: invisible to the outer (cross-targeting) build,
         where TargetFramework is empty. -->
    <PackageReference Include="Net8OnlyPkg" Version="1.0.0" Condition="'$(TargetFramework)' == 'net8.0'" />
  </ItemGroup>
</Project>
